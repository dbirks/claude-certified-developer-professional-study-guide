---
// SelfCheck: question/answer card. "Gelato" design: the answer is always visible on teaching
// chapters. Practice pages pass questions like `question="Answer to Q3"`, where the answer must
// stay behind a "Show answer" disclosure — those default to the reveal variant.
interface Props {
  question: string;
  /** Force the hidden-answer disclosure on (practice) or off (teaching). */
  reveal?: boolean;
}

const { question, reveal = /^\s*answer to\b/i.test(question) } = Astro.props;
---

{
  reveal ? (
    <details class="self-check self-check--reveal">
      <summary class="self-check__q">
        <span class="sr-only">Question:</span>
        <span class="self-check__badge self-check__badge--q" aria-hidden="true">
          Q
        </span>
        <span class="self-check__text">{question}</span>
        <span class="self-check__pill" aria-hidden="true">
          <span class="self-check__pill-show">Show answer</span>
          <span class="self-check__pill-hide">Hide answer</span>
        </span>
      </summary>
      <div class="self-check__a">
        <span class="sr-only">Answer:</span>
        <span class="self-check__badge self-check__badge--a" aria-hidden="true">
          A
        </span>
        <div class="self-check__body">
          <slot />
        </div>
      </div>
    </details>
  ) : (
    <div class="self-check">
      <div class="self-check__q">
        <span class="sr-only">Question:</span>
        <span class="self-check__badge self-check__badge--q" aria-hidden="true">
          Q
        </span>
        <p class="self-check__text">{question}</p>
      </div>
      <div class="self-check__a">
        <span class="sr-only">Answer:</span>
        <span class="self-check__badge self-check__badge--a" aria-hidden="true">
          A
        </span>
        <div class="self-check__body">
          <slot />
        </div>
      </div>
    </div>
  )
}
