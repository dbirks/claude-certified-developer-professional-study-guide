---
// Figure: bordered body plus caption. Holds Flow, Sequence, tables or images.
interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="figure">
  <div class="figure__body">
    <slot />
  </div>
  <figcaption class="figure__caption">{caption}</figcaption>
</figure>
