---
// Figure: filled --surface card holding Flow, Sequence, tables or images, with the caption
// sitting outside, below the card.
interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="figure">
  <div class="figure__body" tabindex="0" role="group" aria-label={caption}>
    <slot />
  </div>
  <figcaption class="figure__caption">{caption}</figcaption>
</figure>
