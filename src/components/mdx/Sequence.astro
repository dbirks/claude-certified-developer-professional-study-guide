---
// Sequence: a UML-style sequence diagram rendered as inline SVG at build time, plus a
// screen-reader list of the same information. Geometry math is fixed by docs/ARCHITECTURE.md.
// All colors come from CSS classes in styles/mdx.css so light/dark themes both work inside SVG.
type SeqTone = 'bad' | 'good';
type SeqMessage = { from: number; to: number; label: string; dashed?: boolean };
type SeqNote = { at: number; note: string; tone?: SeqTone };
type SeqEntry = SeqMessage | SeqNote;

interface Props {
  actors: string[];
  messages: SeqEntry[];
}

const COL_W = 200;
const PAD = 24;
const BOX_W = 140;
const BOX_H = 36;
const HEADER_H = 36;
const ROW_H = 40;

const { actors, messages } = Astro.props;
const names = Array.isArray(actors) ? actors : [];
const entries = Array.isArray(messages) ? messages : [];

const width = PAD * 2 + COL_W * names.length - (COL_W - BOX_W);
const height = HEADER_H + 24 + entries.length * ROW_H + 24;
const colX = (i: number) => PAD + BOX_W / 2 + i * COL_W;
const rowY = (i: number) => HEADER_H + 24 + i * ROW_H + 20;

// Stable, content-derived id so several diagrams on one page don't share marker ids.
const signature = JSON.stringify({ names, entries });
let hash = 5381;
for (let i = 0; i < signature.length; i += 1) {
  hash = ((hash << 5) + hash + signature.charCodeAt(i)) | 0;
}
const uid = `seq${(hash >>> 0).toString(36)}`;
const markerId = `seq-arrow-${uid}`;
const titleId = `${uid}-title`;
const descId = `${uid}-desc`;

const clamp = (value: number, min: number, max: number) => Math.max(min, Math.min(value, Math.max(min, max)));

type Row =
  | { kind: 'msg'; y: number; fromX: number; toX: number; self: boolean; loopX: number; labelX: number; anchor: 'middle' | 'start'; label: string; dashed: boolean }
  | { kind: 'note'; y: number; rectX: number; rectW: number; centerX: number; text: string; tone: SeqTone | 'neutral' };

const rows: Row[] = entries.map((entry, i): Row => {
  const y = rowY(i);
  if ('from' in entry && typeof entry.from === 'number') {
    const fromX = colX(entry.from);
    const toX = colX(entry.to);
    const self = entry.from === entry.to;
    const loopX = fromX + 30;
    return {
      kind: 'msg',
      y,
      fromX,
      toX,
      self,
      loopX,
      labelX: self ? loopX + 8 : (fromX + toX) / 2,
      anchor: self ? 'start' : 'middle',
      label: entry.label,
      dashed: Boolean(entry.dashed),
    };
  }
  const note = 'note' in entry ? entry.note : '';
  const tone: SeqTone | 'neutral' = 'tone' in entry && entry.tone ? entry.tone : 'neutral';
  const rectW = Math.max(BOX_W, note.length * 7);
  const centerX = colX(Math.min(Math.max(0, 'at' in entry ? entry.at : 0), Math.max(0, names.length - 1)));
  const rectX = clamp(centerX - rectW / 2, 4, width - 4 - rectW);
  return { kind: 'note', y, rectX, rectW, centerX: rectX + rectW / 2, text: note, tone };
});

const actorName = (i: number) => names[i] ?? `#${i}`;
const transcript = entries.map((entry) =>
  'from' in entry
    ? `${actorName(entry.from)} → ${actorName(entry.to)}: ${entry.label}`
    : `Note on ${actorName('at' in entry ? entry.at : 0)}: ${'note' in entry ? entry.note : ''}`,
);
---

<div class="seq">
  <svg
    class="seq__svg"
    viewBox={`0 0 ${width} ${height}`}
    width="100%"
    style={`max-width:${width}px; min-width:${Math.min(width, 520)}px`}
    role="img"
    aria-labelledby={`${titleId} ${descId}`}
    preserveAspectRatio="xMinYMin meet"
  >
    <title id={titleId}>{`Sequence: ${names.join(', ')}`}</title>
    <desc id={descId}>{transcript.join('. ')}</desc>
    <defs>
      <marker
        id={markerId}
        markerUnits="userSpaceOnUse"
        markerWidth="9"
        markerHeight="9"
        refX="8.5"
        refY="4.5"
        orient="auto"
      >
        <path class="seq__arrow" d="M0,0 L9,4.5 L0,9 Z"></path>
      </marker>
    </defs>

    {
      names.map((name, i) => (
        <g>
          <line class="seq__life" x1={colX(i)} y1={HEADER_H} x2={colX(i)} y2={height}></line>
          <rect class="seq__box" x={colX(i) - BOX_W / 2} y={0} width={BOX_W} height={BOX_H} rx={6}></rect>
          <text class="seq__actor" x={colX(i)} y={23} text-anchor="middle">
            {name}
          </text>
        </g>
      ))
    }

    {
      rows.map((row) =>
        row.kind === 'msg' ? (
          <g>
            {row.self ? (
              <path
                class={`seq__msg${row.dashed ? ' seq__msg--dashed' : ''}`}
                d={`M ${row.fromX} ${row.y - 6} L ${row.loopX} ${row.y - 6} L ${row.loopX} ${row.y + 6} L ${row.fromX + 2} ${row.y + 6}`}
                marker-end={`url(#${markerId})`}
              ></path>
            ) : (
              <line
                class={`seq__msg${row.dashed ? ' seq__msg--dashed' : ''}`}
                x1={row.fromX}
                y1={row.y}
                x2={row.toX}
                y2={row.y}
                marker-end={`url(#${markerId})`}
              ></line>
            )}
            <text class="seq__label" x={row.labelX} y={row.y - 6} text-anchor={row.anchor}>
              {row.label}
            </text>
          </g>
        ) : (
          <g>
            <rect
              class={`seq__note seq__note--${row.tone}`}
              x={row.rectX}
              y={row.y - 13}
              width={row.rectW}
              height={26}
              rx={4}
            ></rect>
            <text class="seq__note-text" x={row.centerX} y={row.y + 4} text-anchor="middle">
              {row.text}
            </text>
          </g>
        ),
      )
    }
  </svg>
  <ol class="seq__alt sr-only">
    {transcript.map((line) => <li>{line}</li>)}
  </ol>
</div>
