---
// Search dialog shell. Empty on purpose: search.ts lazy-loads Pagefind's UI into
// #search-root on first open (index only exists in the built site).
// ids/classes are the contract in docs/ARCHITECTURE.md — do not rename.
// Layout is Gelato (see src/styles/search.css): Pagefind's own <form> wraps its whole UI,
// so the form is pinned as the dialog's header row (painted as a pill field) and Pagefind's
// result drawer scrolls underneath it. The circle close button lines up with that field row.
import Icon from './Icon.astro';
---

<dialog id="search-dialog" class="search-dialog" aria-label="Search the guide">
  <div class="search-dialog__head">
    <span class="search-dialog__title sr-only">Search</span>
    <button type="button" class="search-dialog__close icon-btn" id="search-close" aria-label="Close search">
      <Icon name="x" size={20} stroke={2} />
    </button>
  </div>
  <div id="search-root" class="search-root"></div>
  <p class="search-dialog__hint">Results link to the matching section.</p>
</dialog>
