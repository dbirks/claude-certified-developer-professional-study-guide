---
// Page shell. DOM ids/classes here are the contract in docs/ARCHITECTURE.md — scripts and CSS depend on them.
import '../styles/global.css';
import Toc from '../components/Toc.astro';
import SearchDialog from '../components/SearchDialog.astro';
import CitePopover from '../components/CitePopover.astro';
import Icon from '../components/Icon.astro';
import { getToc, type TocNode } from '../lib/toc';
import { url } from '../lib/site';

interface Props {
  title: string; // page <title> prefix and topbar section label
  description: string;
  currentId?: string; // TocNode id of the current chapter ("c-reliability"); undefined on home
  onPage?: { depth: number; slug: string; text: string }[]; // H2/H3 of this page for the right rail
  prev?: { href: string; label: string; num?: string };
  next?: { href: string; label: string; num?: string };
}
const { title, description, currentId, onPage = [], prev, next } = Astro.props;
const toc: TocNode[] = await getToc();
const fullTitle = currentId ? `${title} · CCDV-P Study Guide` : 'CCDV-P Study Guide';
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <script is:inline>
      // Apply stored or system theme before first paint (no flash).
      (function () {
        var t;
        try { t = localStorage.getItem('ccdvp:theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body data-current-id={currentId ?? ''} data-base={url('')}>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="progress" aria-hidden="true"><div class="progress__bar" id="progress-bar"></div></div>

    <header class="topbar">
      <div class="topbar__pill">
        <button id="toc-toggle" class="icon-btn topbar__menu" type="button" aria-controls="toc-panel" aria-expanded="false" aria-label="Open table of contents">
          <span class="hamburger" aria-hidden="true"><span></span><span></span><span></span></span>
        </button>
        <a class="topbar__title" href={url('')}>CCDV-P <span class="topbar__title-rest">Study Guide</span></a>
        <span class="topbar__section" id="topbar-section">{currentId ? title : ''}</span>
        <div class="topbar__actions">
          <button id="search-open" class="icon-btn topbar__search" type="button" aria-label="Search" aria-haspopup="dialog">
            <Icon name="search" size={18} stroke={2.75} />
            <span class="topbar__search-text" aria-hidden="true">Search the guide</span>
            <kbd class="topbar__search-key" aria-hidden="true">/</kbd>
          </button>
          <span class="read-pill" id="read-pill" aria-hidden="true" hidden>
            <span class="read-pill__bar"><span class="read-pill__fill" id="read-pill-fill"></span></span>
            <span id="read-pill-text">0%</span>
          </span>
          <button id="theme-toggle" class="icon-btn topbar__theme" type="button" aria-label="Switch color theme">
            <Icon name="moon" size={18} class="theme-icon theme-icon--moon" />
            <Icon name="sun" size={18} class="theme-icon theme-icon--sun" />
          </button>
        </div>
      </div>
    </header>

    <div class="shell">
      <aside id="toc-panel" class="toc-panel" aria-label="Table of contents" data-state="closed">
        <div class="toc-panel__head">
          <span class="toc-panel__title">Contents</span>
          <div class="toc-controls" role="group" aria-label="Table of contents view">
            <button type="button" class="toc-controls__btn" data-toc-action="collapse-all">Collapse all</button>
            <button type="button" class="toc-controls__btn" data-toc-action="expand-current">Current</button>
            <button type="button" class="toc-controls__btn" data-toc-action="expand-all">Expand all</button>
            <div class="theme-switch" role="group" aria-label="Color theme">
              <button type="button" data-theme-set="light" aria-pressed="false" aria-label="Light theme"><Icon name="sun" size={15} /></button>
              <button type="button" data-theme-set="dark" aria-pressed="false" aria-label="Dark theme"><Icon name="moon" size={15} /></button>
            </div>
          </div>
          <button id="toc-close" class="icon-btn toc-panel__close" type="button" aria-label="Close table of contents">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
          </button>
        </div>
        <nav class="toc" aria-label="Chapters">
          <Toc nodes={toc} currentId={currentId} />
        </nav>
      </aside>
      <div id="toc-backdrop" class="toc-backdrop" hidden></div>

      <main id="main" class="main" tabindex="-1">
        <article class="prose" data-pagefind-body>
          <slot />
        </article>
        {(prev || next) && (
          <nav class="pager" aria-label="Chapter navigation">
            {prev ? (
              <a class="pager__link pager__link--prev" href={prev.href} rel="prev">
                <span class="pager__dir"><Icon name="arrow-left" size={14} stroke={2.75} /><span class="sr-only">Previous: </span>{prev.num ?? 'Previous'}</span>
                <span class="pager__label">{prev.label}</span>
              </a>
            ) : <span></span>}
            {next ? (
              <a class="pager__link pager__link--next" href={next.href} rel="next">
                <span class="pager__dir"><span class="sr-only">Next: </span>{next.num ?? 'Next'}<Icon name="arrow-right" size={14} stroke={2.75} /></span>
                <span class="pager__label">{next.label}</span>
              </a>
            ) : <span></span>}
          </nav>
        )}
      </main>

      {onPage.length > 0 && (
        <aside class="onpage" aria-label="On this page">
          <p class="onpage__title">On this page</p>
          <ul class="onpage__list">
            {onPage.filter((h) => h.depth === 2 || h.depth === 3).map((h) => (
              <li class:list={['onpage__item', `onpage__item--h${h.depth}`]}><a href={`#${h.slug}`} data-onpage-link={h.slug}>{h.text}</a></li>
            ))}
          </ul>
        </aside>
      )}
    </div>

    <button id="back-to-top" class="back-to-top" type="button" aria-label="Back to top" hidden>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"></path></svg>
    </button>

    <SearchDialog />
    <CitePopover />

    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
